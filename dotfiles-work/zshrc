RAD_DOTFILES_PROFILE=work

# Detect and set DOTFILES_DIR
for d in "$HOME/icode/dotfiles" "$HOME/code/dotfiles" "$HOME/projects/dotfiles"; do
  [[ -d $d ]] && { DOTFILES_DIR=$d; break; }
done

(
  rad-realpath () {
    local target=$1
    # Resolve symlinks
    while [ -L "$target" ]; do
      dir=$(cd "$(dirname "$target")" && pwd -P) || return 1
      link=$(readlink "$target") || return 1
      case $link in /*) target=$link ;; *)  target="$dir/$link" ;; esac
    done
    # Resolve to absolute physical path
    dir=$(cd "$(dirname "$target")" && pwd -P) || return 1; echo "$dir/$(basename "$target")"
  }
  RAD_ZSHRC_PATH="$(print -r -- "${(%):-%x}")"
  DOTFILES_ZSHRC_PATH="$(rad-realpath "${(%):-%x}")"
  if [[ "${RAD_ZSHRC_PATH}" == "${DOTFILES_ZSHRC_PATH}" ]]; then
    cd "${DOTFILES_DIR}"; ./install_dotfiles.sh "${RAD_DOTFILES_PROFILE}"
  fi

  [[ ! -f ~/.zshrc_global.zsh ]] && cd $DOTFILES_DIR && git stash && git branch -u origin/master && git pull && git stash pop && ./install_dotfiles.sh "${RAD_DOTFILES_PROFILE}"
)

source ~/.zshrc_global.zsh

# just f'in call it
compinit
