#!/usr/bin/env bash
# install - Interactive Dotbot installation wrapper
# Usage: ./install [home|work|base]

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

usage() {
  echo "Usage: ./install [home|work|base]"
  echo ""
  echo "Profiles:"
  echo "  home   - Personal development environment (default)"
  echo "  work   - Work environment"
  echo "  base   - Base configuration only"
  exit "${1:-0}"
}

# Each profile is the ordered list of install-<name>.conf.yaml files it runs. The whole
# list is chosen before anything runs, so an unknown profile installs nothing.
case "${1-home}" in
  home) configs=(base home rad agent-cli) ;;
  work) configs=(base work agent-cli) ;;
  base) configs=(base) ;;
  -h|--help) usage ;;
  *)
    echo "install: unknown profile: '${1}'" >&2
    usage 1 >&2
    ;;
esac

for config in "${configs[@]}"; do
  echo "Installing ${config}..."
  uvx dotbot -d "${BASEDIR}" -c "install-${config}.conf.yaml"
done

echo "✓ Installation complete!"
