# Pull command from buffer
rad_pull_buffer() {
    if [[ -n "$BUFFER" ]]; then
        echo $BUFFER | pbcopy
        BUFFER=""
        zle -I && zle redisplay
        zle end-of-line
    fi
}
zle -N rad_pull_buffer
bindkey '^[p' rad_pull_buffer
