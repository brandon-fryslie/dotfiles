cargo() {
  echo "CARGO WRAPPER"
  local WORKSPACE_ROOT PACKAGE_BASENAME TARGET_DIRECTORY
  local cargo_bin="${HOME}/.cargo/bin/cargo"
  export RUST_BUILD_BASE="$HOME/.cache/rust-builds"
  WORKSPACE_ROOT="$("${cargo_bin}" metadata --no-deps --offline 2>/dev/null | jq -r ".workspace_root")"
  PACKAGE_BASENAME="$(basename "${WORKSPACE_ROOT}")"
  TARGET_DIRECTORY="$("${cargo_bin}" metadata --no-deps --offline 2>/dev/null | jq -r ".target_directory")"

  # Check if target has default location
  if [[ $TARGET_DIRECTORY == "$WORKSPACE_ROOT/target" ]]; then
          # Run cargo with target set to $RUST_BUILD_BASE/$PACKAGE_BASENAME
          CARGO_TARGET_DIR="$RUST_BUILD_BASE/$PACKAGE_BASENAME" $cargo_bin $@
  else
          # Do nothing, target dir is configured to smth non-default
          $cargo_bin $@
  fi
}

function ai_generate_command() {
  echo "shl: running sgpt --shell: $*" >> ~/.shl.log
  sgpt --shell --no-interaction "$*"
  echo "shl: ran sgpt --shell: $@" >> ~/.shl.log
}

function zle_run_buffer_replace() {
  BUFFER="$1"
  CURSOR=${#BUFFER}
}

zle -N zle_run_buffer_replace

function shl() {
  echo "shl: running. args: $@" >> ~/.shl.log
  local generated_output="$(ai_generate_command "$@")"
  echo "shl: generated output. output: $generated_output" >> ~/.shl.log
  local command_part="${generated_output%%\#*}"
  echo "shl: command part: $command_part" >> ~/.shl.log
  command_part="${command_part%"${command_part##*[![:space:]]}"}"
  echo "shl: command part 2: $command_part" >> ~/.shl.log
  vared -c "zle zle_run_buffer_replace -- \"$command_part\""
}

