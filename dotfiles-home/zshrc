# move to plugin
installdmg() {
  local input=$1
  [[ -z $input ]] && { echo "ERROR: Must provide path to .dmg or a directory containing one"; return 1; }

  # Locate first .dmg (not in __MACOSX, not starting with _)
  local dmg_path
  if [[ -d $input ]]; then
    dmg_path=$(find "$input" -type f -name '*.dmg' ! -path '*/__MACOSX/*' ! -name '_*' | head -n 1)
  elif [[ -f $input && $input == *.dmg ]]; then
    dmg_path=$input
  else
    echo "ERROR: Invalid input. Must be a .dmg file or directory containing one."
    return 1
  fi

  [[ -z $dmg_path ]] && { echo "ERROR: No valid .dmg found in $input"; return 1; }

  echo "Mounting outer DMG: $dmg_path"
  local outer_mount=$(hdiutil attach "$dmg_path" -nobrowse -quiet | grep Volumes)
  local outer_dev=$(echo "$outer_mount" | cut -f 1)
  local outer_vol=$(echo "$outer_mount" | cut -f 3-)

  # Look for nested .dmg inside mounted volume
  local nested_dmg=$(find "$outer_vol" -type f -name '*.dmg' ! -name '_*' | head -n 1)
  local mount_vol=""
  local mount_dev=""

  if [[ -n $nested_dmg ]]; then
    echo "Found nested DMG: $nested_dmg"
    local nested_mount=$(hdiutil attach "$nested_dmg" -nobrowse -quiet | grep Volumes)
    mount_dev=$(echo "$nested_mount" | cut -f 1)
    mount_vol=$(echo "$nested_mount" | cut -f 3-)
  else
    mount_dev=""
    mount_vol="$outer_vol"
  fi

  # Install .app files (ignoring names starting with _)
  local installed=false
  for app in "$mount_vol"/*.app(N); do
    [[ "$(basename "$app")" == _* ]] && continue
    echo "Installing $(basename "$app")..."
    sudo cp -R "$app" /Applications
    sudo xattr -rd com.apple.quarantine "/Applications/$(basename "$app")"
    installed=true
  done

  # If no .app installed, try .pkg (also ignore names starting with _)
  if [[ $installed == false ]]; then
    local pkg=$(find "$mount_vol" -type f -name '*.pkg' ! -name '_*' | head -n 1)
    if [[ -n $pkg ]]; then
      echo "Installing package: $(basename "$pkg")"
      sudo installer -pkg "$pkg" -target /
      installed=true
    fi
  fi

  if [[ $installed == false ]]; then
    echo "ERROR: No .app or .pkg found in $mount_vol"
  fi

  [[ -n $mount_dev ]] && hdiutil detach "$mount_dev" -quiet
  hdiutil detach "$outer_dev" -quiet
}

