{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "worktree": {
    "baseRef": "fresh"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(diff:*)",
      "Bash(docker:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(img4tool:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pip3:*)",
      "Bash(pip:*)",
      "Bash(pwd:*)",
      "Bash(pytest:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(sudo pfctl:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(tsx:*)",
      "Bash(uv run:*)",
      "Bash(uv:*)",
      "Bash(wc:*)",
      "Bash(wget:*)",
      "Bash(which:*)",
      "BashOutput(*)",
      "Edit(*)",
      "ExitPlanMode(*)",
      "Fetch(*)",
      "Glob(*)",
      "Grep(*)",
      "KillShell(*)",
      "Ls(*)",
      "mcp__chrome-devtools",
      "MultiEdit(*)",
      "NotebookEdit(*)",
      "Read(*)",
      "SlashCommand(*)",
      "Task(*)",
      "TodoRead(*)",
      "TodoWrite(*)",
      "Update(*)",
      "Write(*)",
      "Bash(osascript:*)",
      "mcp__cherry-chrome__chrome_list_connections",
      "Bash(lsof:*)",
      "Skill(do:it)",
      "Skill(do:it-skill)",
      "Skill(do:plan-skill)",
      "Skill(do:plan)",
      "Skill(superpowers:brainstorming)",
      "Bash(pkill:*)",
      "mcp__cherry-chrome__chrome",
      "mcp__cherry-chrome__connect",
      "mcp__chatgpt-convo__chatgpt",
      "mcp__cherry-chrome__query_elements",
      "Bash(npm run typecheck:*)",
      "mcp__cherry-chatgpt__chatgpt_get_messages",
      "mcp__cherry-chatgpt__chatgpt_open",
      "mcp__cherry-chatgpt__chatgpt_find_conversation"
    ],
    "deny": [
      "mcp__claude_ai_Claude_Docs"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/bmf/code/dotfiles/config/claude/hooks/guard-tmux-server.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/bmf/code/dotfiles/config/claude/hooks/guard-tmux-server.sh"
          },
          {
            "type": "command",
            "command": "/Users/bmf/code/dotfiles/config/claude/hooks/guard-session-url.sh"
          },
          {
            "type": "command",
            "command": "/Users/bmf/code/dotfiles/config/claude/hooks/hyphenate-handoff.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/bmf/.claude/statusline-candybar",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "lit@lit": true,
    "laws@promptctl": true,
    "memento@memento": true
  },
  "extraKnownMarketplaces": {
    "lit": {
      "source": {
        "source": "github",
        "repo": "promptctl/links-issue-tracker"
      }
    },
    "promptctl": {
      "source": {
        "source": "directory",
        "path": "/Users/bmf/code/promptctl_laws"
      }
    },
    "memento": {
      "source": {
        "source": "github",
        "repo": "promptctl/memento"
      }
    }
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(lit:*)",
      "Bash(crom:*)"
    ]
  },
  "enableArtifact": false,
  "spinnerTipsEnabled": false,
  "feedbackDrafts": "off",
  "promptSuggestionEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "theme": "dark",
  "editorMode": "normal",
  "tui": "fullscreen"
}
