{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "worktree": {
    "baseRef": "fresh"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(diff:*)",
      "Bash(docker:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(img4tool:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pip3:*)",
      "Bash(pip:*)",
      "Bash(pwd:*)",
      "Bash(pytest:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(sudo pfctl:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(tsx:*)",
      "Bash(uv run:*)",
      "Bash(uv:*)",
      "Bash(wc:*)",
      "Bash(wget:*)",
      "Bash(which:*)",
      "BashOutput(*)",
      "Edit(*)",
      "ExitPlanMode(*)",
      "Fetch(*)",
      "Glob(*)",
      "Grep(*)",
      "KillShell(*)",
      "Ls(*)",
      "mcp__chrome-devtools",
      "MultiEdit(*)",
      "NotebookEdit(*)",
      "Read(*)",
      "SlashCommand(*)",
      "Task(*)",
      "TodoRead(*)",
      "TodoWrite(*)",
      "Update(*)",
      "Write(*)",
      "Bash(osascript:*)",
      "mcp__cherry-chrome__chrome_list_connections",
      "Bash(lsof:*)",
      "Skill(do:it)",
      "Skill(do:it-skill)",
      "Skill(do:plan-skill)",
      "Skill(do:plan)",
      "Skill(superpowers:brainstorming)",
      "Bash(pkill:*)",
      "mcp__cherry-chrome__chrome",
      "mcp__cherry-chrome__connect",
      "mcp__chatgpt-convo__chatgpt",
      "mcp__cherry-chrome__query_elements",
      "Bash(npm run typecheck:*)",
      "mcp__cherry-chatgpt__chatgpt_get_messages",
      "mcp__cherry-chatgpt__chatgpt_open",
      "mcp__cherry-chatgpt__chatgpt_find_conversation"
    ],
    "deny": [
      "Bash(tmux kill-server:*)",
      "mcp__claude_ai_Claude_Docs"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_response.filePath // .tool_input.file_path // empty'); case \"$f\" in *claude/settings*.json) exit 0;; esac; if [ -n \"$f\" ] && [ -f \"$f\" ] && grep -qi 'kill-server' \"$f\"; then m=\"HARD STOP. You just wrote kill-server into $f. That line destroys the ENTIRE tmux server and every session and every process attached to it. On 2026-08-25 this exact line, buried in a test teardown, wiped every Claude session on this machine and hours of work across nine projects. That was a stupid, careless thing to write, and you are being shut down for it. Go delete that line right now. If you need to tear down tmux in a test, use 'tmux kill-session -t <name>' or an isolated '-L <socket>' - never a server-wide kill.\"; jq -n --arg m \"$m\" '{continue:false,decision:\"block\",reason:$m,stopReason:$m,systemMessage:$m}'; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -qwiE 'kill-server'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"BLOCKED: kill-server is permanently forbidden. tmux kill-server destroys the entire tmux server and every session and process attached to it. Use a session-scoped kill-session, or an isolated TMUX_TMPDIR/-L socket, never kill-server.\"}}'; fi"
          },
          {
            "type": "command",
            "command": "/Users/bmf/code/dotfiles/config/claude/hooks/guard-session-url.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/bmf/code/dotfiles/config/claude/hooks/guard-generated-workflow.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/bmf/.claude/statusline-candybar",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "lit@lit": true,
    "laws@promptctl": true,
    "memento@memento": true
  },
  "extraKnownMarketplaces": {
    "lit": {
      "source": {
        "source": "github",
        "repo": "promptctl/links-issue-tracker"
      }
    },
    "promptctl": {
      "source": {
        "source": "directory",
        "path": "/Users/bmf/code/promptctl_laws"
      }
    },
    "memento": {
      "source": {
        "source": "github",
        "repo": "promptctl/memento"
      }
    }
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(lit:*)",
      "Bash(crom:*)"
    ]
  },
  "enableArtifact": false,
  "spinnerTipsEnabled": false,
  "feedbackDrafts": "off",
  "promptSuggestionEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "theme": "dark",
  "editorMode": "normal",
  "tui": "fullscreen"
}
