#!/usr/bin/env bash
set -euo pipefail

# [LAW:decomposition] This part does ONE thing: put a fresh claude (with
# skip-permissions) in the tmux session named for a repo, wait until it is ready
# for input, and print its address. Briefing it and reading its work is the
# controller's job through /tmux-talk and /tmux-command — not fused here.

USAGE="repo-session — launch claude (--dangerously-skip-permissions) in a repo's tmux session

Usage:
  repo-session <repo> [-- <extra claude args>...]

  <repo>   A directory path, or a bare name resolved as ~/code/<name>.

The tmux session is named after the directory's basename ('.' and ':' become
'_', as tmux requires). Missing session: created detached, rooted at the repo.
Existing session: a new detached window is added to it — no existing pane is
reused, and no attached client's view is switched.

claude is the pane's own process: no shell runs in front of it, so no rc file,
prompt theme, or shell plugin runs in that pane. The pane closes when claude
exits cleanly; a claude that crashes leaves its screen in a dead pane.

Prints the claude pane's address (session:window.pane) on stdout once claude
shows its input prompt. Fails loudly, with the pane's screen, if claude exits or
stops at a dialog before then, or is not up within REPO_SESSION_BOOT_TIMEOUT
seconds (default 90)."

[[ $# -ge 1 ]] || { echo "$USAGE" >&2; exit 1; }
case "$1" in -h|--help) echo "$USAGE"; exit 0 ;; esac

REPO_ARG="$1"; shift
EXTRA_ARGS=()
if [[ $# -gt 0 ]]; then
  [[ "$1" == "--" ]] || { echo "repo-session: unexpected argument '$1' (extra claude args go after --)" >&2; exit 1; }
  shift
  EXTRA_ARGS=("$@")
fi

# [LAW:no-silent-failure] a bare name means ~/code/<name>; anything else is a path.
# Either way it must exist — never create a repo directory by accident.
if [[ "$REPO_ARG" != */* && ! -d "$REPO_ARG" ]]; then
  REPO_ARG="$HOME/code/$REPO_ARG"
fi
[[ -d "$REPO_ARG" ]] || { echo "repo-session: no such directory: $REPO_ARG" >&2; exit 1; }
REPO_DIR=$(cd "$REPO_ARG" && pwd -P)

BASENAME=$(basename "$REPO_DIR")
SESSION=${BASENAME//[.:]/_}

# [LAW:one-source-of-truth] the claude this controller runs is the claude the
# instance runs. The window inherits the tmux server's environment, not this
# one's, so the binary is resolved here and passed by absolute path.
CLAUDE_BIN=$(command -v claude) || { echo "repo-session: no 'claude' on PATH" >&2; exit 1; }

# A multi-argument window command is exec'd by tmux as-is, with no shell: argv
# reaches claude token for token, and nothing sources a rc. Claude's own
# subprocess shell is the managed settings' decision (settings.managed.json
# env.CLAUDE_CODE_SHELL), not this launcher's.
CMD=("$CLAUDE_BIN" --dangerously-skip-permissions ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"})

ADDR_FMT='#{session_name}:#{window_index}.#{pane_index}'
# [LAW:no-ambient-temporal-coupling] -d on both paths: the user is usually
# attached to these sessions, and a non-detached new-window switches their screen.
# remain-on-exit failed is set in the same tmux request that creates the window,
# so a claude that dies at once cannot outrun it. A crash keeps its screen: at
# boot this script reads it, reports it, and removes the window; hours in, it
# stays for whoever reads the pane. A clean exit closes the pane. The option is
# addressed to {end}, where -a puts the new window — a bare target in a command
# sequence is the user's current window.
REMAIN=(set-option -w -t "=$SESSION:{end}" remain-on-exit failed)
if tmux has-session -t "=$SESSION" 2>/dev/null; then
  ADDRESS=$(tmux new-window -d -a -t "=$SESSION:{end}" -c "$REPO_DIR" -n claude -P -F "$ADDR_FMT" "${CMD[@]}" \; "${REMAIN[@]}")
else
  ADDRESS=$(tmux new-session -d -s "$SESSION" -c "$REPO_DIR" -n claude -P -F "$ADDR_FMT" "${CMD[@]}" \; "${REMAIN[@]}")
fi
[[ -n "$ADDRESS" ]] || { echo "repo-session: tmux returned no address" >&2; exit 1; }
echo "repo-session: $ADDRESS (cwd $REPO_DIR) running:$(printf ' %q' "${CMD[@]}")" >&2

# [LAW:no-silent-failure] the address is only worth printing once claude can
# take a message. A dialog at boot means a human decision is pending: report it
# with the screen rather than answering it on the user's behalf.
TIMEOUT=${REPO_SESSION_BOOT_TIMEOUT:-90}
DEADLINE=$((SECONDS + TIMEOUT))
while (( SECONDS < DEADLINE )); do
  sleep 2
  # A pane that exited 0 has already closed (remain-on-exit failed keeps only
  # failures), so the window itself can be gone here: say so, in these words.
  SCREEN=$(tmux capture-pane -p -t "$ADDRESS") || {
    echo "repo-session: $ADDRESS is gone: claude exited 0 before it was ready, or the window was closed" >&2
    exit 1
  }
  if [[ $(tmux display-message -p -t "$ADDRESS" '#{pane_dead}') == 1 ]]; then
    # The status is reported with the screen: a process that exits within
    # milliseconds can leave the screen blank (unread pty output is dropped).
    STATUS=$(tmux display-message -p -t "$ADDRESS" '#{pane_dead_status}')
    echo "repo-session: claude in $ADDRESS exited with status $STATUS before it was ready; screen:" >&2
    echo "$SCREEN" >&2
    tmux kill-window -t "$ADDRESS"
    exit 1
  fi
  if grep -qiE 'trust (the files in )?this folder|Bypass Permissions mode|Yes, I accept' <<<"$SCREEN"; then
    echo "repo-session: claude in $ADDRESS stopped at a dialog that needs the user:" >&2
    echo "$SCREEN" >&2
    exit 2
  fi
  # Ready = claude's input prompt is drawn and nothing is spinning.
  if grep -q '❯' <<<"$SCREEN" && ! grep -q 'ing…' <<<"$SCREEN"; then
    echo "$ADDRESS"
    exit 0
  fi
done

echo "repo-session: claude in $ADDRESS not ready after ${TIMEOUT}s; screen:" >&2
tmux capture-pane -p -t "$ADDRESS" >&2
exit 1
