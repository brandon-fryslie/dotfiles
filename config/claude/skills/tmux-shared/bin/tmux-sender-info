#!/usr/bin/env bash
set -uo pipefail

# [LAW:one-source-of-truth] One definition of "who is sending this, and how much
# room do they have left". tmux-talk is the only caller: it puts this in the
# `Sender:` header of the envelope its receiver reads. tmux-command deliberately
# does not use it — its receiver is a CLI parser, which reads nothing. This lives
# in tmux-shared beside the resolver because a second driver would want the line
# verbatim rather than reimplemented, and a copy would drift the moment the
# transcript format moves.
#
# The model and context size are read from the sender's OWN session transcript:
# the last main-thread assistant turn's usage is the harness's own count, so
# there is nothing to estimate. That turn's three input figures are the whole
# prompt it was sent, which already contains every earlier response — output
# becomes input on the following turn. Only the newest response has not been fed
# back yet, so it is added explicitly; leaving it out would under-report by a
# whole turn of thinking exactly when the sender is least able to afford it.
# A sender that is not a Claude session (a human shell) has no such facts, and
# the line carries the working directory alone.
#
# This part is advisory: printing a line always is the contract, so a lookup that
# fails degrades the line to the directory rather than failing the send it
# decorates. [LAW:no-silent-failure] It still says why on stderr, which tmux-talk
# passes through to the sender. Only a sender with no session id is silent, since
# a human shell is not a failure.

usage_line() {
  local transcript usage
  [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]] || return 0

  # [LAW:one-source-of-truth] claude-shared's claude-transcript is the lookup
  # share-slop uses too, so the two cannot read different transcripts for one
  # session. It names the reason on stderr when there is no single transcript.
  transcript="$("$(dirname "$0")/../../claude-shared/bin/claude-transcript" "$CLAUDE_CODE_SESSION_ID")" || return 0

  # Each line is parsed on its own (-R plus fromjson?), so a malformed line — half
  # written while we read it, truncated by an old crash — costs that one line
  # instead of stopping the scan and freezing the reported figure. Lines that are
  # not an assistant message object are passed over by shape, not by catching
  # errors: a usage the selector admits but cannot sum is a transcript format this
  # script no longer understands, and jq says so on stderr rather than the figure
  # quietly freezing at the last old-format turn. <synthetic> turns are the
  # harness's error and interrupt placeholders: zero usage, no model.
  usage="$(jq -rR '
    fromjson?
    | objects
    | select(.type == "assistant" and .isSidechain != true and (.message | type) == "object"
             and .message.usage != null and .message.model != "<synthetic>")
    | .message as $m
    | ($m.usage | (.input_tokens + .cache_read_input_tokens + .cache_creation_input_tokens + .output_tokens) // 0) as $t
    | "\($m.model) · \(($t / 1000) | round)k tokens of context · "' "$transcript" | tail -n 1)" || return 0
  [[ -n "$usage" ]] || { echo "tmux-sender-info: no main-thread assistant turn with usage in $transcript" >&2; return 0; }
  printf '%s' "$usage"
}

# Anchored at a path separator so /Users/bmfoo does not render as ~oo, and as a
# case pattern so bash 3.2 (macOS /bin/bash) prints ~ rather than a literal \~.
dir="$PWD"
case "$dir" in
  "$HOME"|"$HOME"/*) dir="~${dir#"$HOME"}" ;;
esac

printf '%s%s\n' "$(usage_line)" "$dir"
