#!/usr/bin/env bash
set -euo pipefail

# [LAW:one-source-of-truth] The ONE definition of the pane line the drivers
# show an agent: id first, as the handle to record, then where the pane sits
# right now, then what runs in it. tmux-talk list, tmux-command list, and
# tmux-command context all print this line, so a column added here appears in
# all three and the SKILL docs describe one shape.
#
#   tmux-panes          every pane on the server
#   tmux-panes %N       that pane alone; exits 1 if no pane has the id
#
# The single-pane form filters list-panes on the exact id: list-panes -t %N
# lists the pane's whole window, and display-message -t on an id no pane has
# exits 0 with every field empty [LAW:no-silent-failure].

LINE='#{pane_id}  #{session_name}:#{window_index}.#{pane_index}  cmd=#{pane_current_command}  title=#{pane_title}'

case "${1:-}" in
  '') tmux list-panes -a -F "$LINE" ;;
  %*) tmux list-panes -t "$1" -f "#{==:#{pane_id},$1}" -F "$LINE" ;;
  *)  echo "tmux-panes: expected a pane id (%N) or nothing, got '$1'" >&2; exit 1 ;;
esac
