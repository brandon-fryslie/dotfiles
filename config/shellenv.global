# The environment every zsh and every interactive or login bash starts with, as
# ~/.zshenv, ~/.bashrc and ~/.bash_profile. Plain POSIX sh so both shells read it.
# Non-interactive bash (scripts, cron) reads none of these; it needs $BASH_ENV.

# Homebrew on the PATH, including the non-interactive zsh ssh runs commands in
export PATH=/opt/homebrew/bin:/opt/homebrew/sbin:$PATH

# CA trust config (SSL_CERT_FILE, UV_SYSTEM_CERTS, ...). The local.ca-env launchd
# agent only reaches the GUI session; ssh sessions start outside it. Both are
# rendered by config/certs/regen-ca-bundle.py from one table.
. ~/.config/certs/env.sh
