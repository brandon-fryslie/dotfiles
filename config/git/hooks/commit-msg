#!/usr/bin/env bash
# Refuse any commit whose message carries a Claude session URL.
# commit-msg, not pre-commit: pre-commit runs before the message exists and
# cannot see the trailer, which is the entire leak.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

if scan_file_for_session_url "$1"; then
  refuse "This commit message contains a link to a private Claude conversation." "$1"
  exit 1
fi

chain_to_local_hook commit-msg "$@"
