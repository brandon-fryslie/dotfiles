#!/bin/bash
# open-at-root <code-cli> <file>...
#
# Open each file in VS Code on the git work tree that contains it, so a
# double-click in Finder lands in the repo's window instead of a bare editor.
# A file outside any repo opens on its own. Code Root.app (built by
# scripts/setup-code-root.sh) runs this with the files Finder hands it; a
# non-zero exit becomes an error dialog there. [LAW:no-silent-failure]
set -euo pipefail

cli="$1"
shift

for file in "$@"; do
  if root=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>&1); then
    "$cli" "$root" "$file"
  elif [[ "$root" == *"not a git repository"* ]]; then
    "$cli" "$file"
  else
    echo "open-at-root: git failed for $file: $root" >&2
    exit 1
  fi
done
