#!/bin/bash
# open-at-root <code-cli> <file>...
#
# Open each file in VS Code on the git work tree that contains it, so a
# double-click in Finder lands in the repo's window instead of a bare editor.
# A file outside any repo opens on its own. Code Root.app (built by
# scripts/setup-code-root.sh) runs this with the files Finder hands it.
#
# Every file opens; the root only picks the window. Any failure - a file that
# vanished, a git error other than "no work tree here", VS Code refusing - is
# reported once the rest have opened, as a non-zero exit that Code Root.app
# shows as an alert. [LAW:no-silent-failure]
set -euo pipefail

cli="$1"
shift

status=0
for file in "$@"; do
  # git reports the root of the real file, and VS Code counts a file as inside
  # that root only under the same resolved path.
  file="$(realpath "$file")" || { status=1; continue; }
  # LC_ALL=C keeps git's message in the English the match below reads.
  root=$(LC_ALL=C git -C "$(dirname "$file")" rev-parse --show-toplevel 2>&1) || {
    case "$root" in
      # Outside any repo, or inside a .git directory or bare repo: no work tree holds the file.
      *"not a git repository"* | *"must be run in a work tree"*) ;;
      *) echo "open-at-root: git failed for $file: $root" >&2; status=1 ;;
    esac
    root=""
  }
  "$cli" ${root:+"$root"} "$file" || status=1 # [LAW:dataflow-not-control-flow]
done
exit "$status"
